# ---- 用户数据（render 产物，含真实积分/昵称，不入库）----
dashboard_data.js
dashboard_inline.html

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 打包产物（由 scripts/build_dist.py / GitHub Actions 生成，经 Releases 分发）----
dist/

# ---- 系统/编辑器 ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---- 本地运行日志 ----
*.log

# ---- 临时验证脚本与 Playwright profile（用完即弃，不入库）----
.tmp-verify/

# ---- 工作区内部状态（宿主工具生成，不随仓库分发）----
.workbuddy/
